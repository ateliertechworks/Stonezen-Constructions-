# Stonezen OS — environment template.
# Copy to `.env.local` and fill in real values. NEVER commit the filled-in file.
#
#   cp .env.example .env.local
#
# On Vercel set these under Project → Settings → Environment Variables
# (Production + Preview + Development). Do not put them in the repo.

# ---------------------------------------------------------------- server only
# Postgres connection string. The API picks its driver from the host:
# a *.neon.tech URL uses Neon's HTTP driver, anything else uses `pg`.
#
# Hosted (Vercel): Neon console -> your project -> Connection Details ->
# "Pooled connection". Must include ?sslmode=require.
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/stonezen?sslmode=require
#
# Local: `npm run db:up` starts a Postgres container using exactly the user,
# password, database and port in this URL. Pick your own password.
DATABASE_URL=postgresql://stonezen:CHOOSE-A-PASSWORD@127.0.0.1:5433/stonezen

# Secret used to sign session tokens. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-me-with-a-long-random-string

# Session lifetime in seconds (default 604800 = 7 days).
AUTH_TTL_SECONDS=604800

# ------------------------------------------------------------- client-exposed
# Anything prefixed VITE_ is compiled INTO the browser bundle and is public.
# Never put DATABASE_URL, AUTH_SECRET or any password behind a VITE_ prefix.

# Base URL for the API. Leave blank to use same-origin /api (correct for Vercel).
VITE_API_BASE_URL=
